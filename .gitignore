.cache/
allure-results/
.coverage
*.py,cover
htmlcov/  # если используете coverage для генерации отчёта

# Каталоги сборки
build/
dist/

# Логи и отладочная информация
*.log

# Файлы IDE (если тесты пишутся в PyCharm, VS Code и т.п.)
.idea/
.vscode/
.pycharm/